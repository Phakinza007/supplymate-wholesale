{
  "name": "ecom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "VITE_SHOWCASE_MODE=false vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && VITE_SHOWCASE_MODE=false vite build",
    "build:pages": "VITE_DEPLOY_TARGET=github-pages tsc -b && vite build",
    "lint": "oxlint && node scripts/check-core-boundary.mjs && node scripts/check-database-types.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "pretest:e2e": "supabase start && node scripts/write-e2e-env.mjs && supabase db reset --yes",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --passWithNoTests",
    "test:showcase-e2e": "E2E_SERVERS=showcase playwright test --project=showcase",
    "test:showcase-artifact": "node scripts/assert-static-showcase.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "oxlint": "^1.75.0",
    "supabase": "^2.111.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  }
}
